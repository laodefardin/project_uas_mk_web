RewriteEngine On

# Sesuaikan dengan nama folder proyek kalian di htdocs
RewriteBase /pertemuan12/

# Jangan ganggu berkas dan folder yang benar-benar ada
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# /login  ->  index.php?act=login
RewriteRule ^([a-z0-9\-]+)/?$ index.php?act=$1 [QSA,L]

# /login?error=...  tetap membawa parameternya
RewriteRule ^prosesLogin/?$ index.php?act=prosesLogin [QSA,L]

# /edit/24010001  ->  index.php?act=edit&nim=24010001
RewriteRule ^edit/([^/]+)/?$ index.php?act=edit&nim=$1 [QSA,L]

# /hapus/24010001  ->  index.php?act=hapus&nim=24010001
RewriteRule ^hapus/([^/]+)/?$ index.php?act=hapus&nim=$1 [QSA,L]

# Tutup akses langsung ke folder internal
RewriteRule ^(config|models|controllers|views)/ - [F,L]

# Matikan daftar isi folder
Options -Indexes
